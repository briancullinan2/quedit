{
	"compilerOptions": {
		"target": "ES6",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": [
			"node"
		],
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2017",
			"ESNext"
		],
		"rootDir": "./",
		"noEmit": false,
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": false,
		"ignoreDeprecations": "6.0"
	},
	"include": [
		"components/bundle/*",
		"*.d.ts",
		"**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"**/node_modules",
		"build",
		"docs",
		"source/page/node_modules",
		"**/*.nsp",
		"**/*.js.mem",
		"**/.git"
	]
}
